{
  "name": "advanced-javascript-org",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm --filter api build && pnpm --filter web build",
    "db:up": "docker compose -f infra/db.compose.yml up -d",
    "db:down": "docker compose -f infra/db.compose.yml down",
    "db:migrate": "goose -env apps/api/.env -dir apps/api/db/migrations up",
    "db:migrate:prod": "node scripts/goose-prod.mjs up",
    "db:status": "goose -env apps/api/.env -dir apps/api/db/migrations status",
    "db:status:prod": "node scripts/goose-prod.mjs status",
    "docker:build": "docker build -f infra/Dockerfile -t advanced-javascript-org .",
    "docker:run": "docker run --rm --env-file apps/api/.env -e PORT=3000 -e API_PORT=8081 -e LOCAL_API_URL=http://127.0.0.1:8081 -e DB_CONNECTION_STRING=grpc://host.docker.internal:2136/local -e WEB_ORIGIN=http://localhost:3000 -p 3000:3000 advanced-javascript-org",
    "docker:build-api": "docker build -f infra/api.Dockerfile -t advanced-javascript-org-api .",
    "docker:run-api": "docker run --rm --env-file apps/api/.env -p 8080:8080 advanced-javascript-org-api",
    "dev": "turbo run dev",
    "seed": "pnpm --filter api seed",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
