{
  "name": "advanced-javascript-org",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm --filter api build && pnpm --filter web build",
    "db:up": "docker compose -f infra/postgres.compose.yaml up -d",
    "db:down": "docker compose -f infra/postgres.compose.yaml down",
    "db:logs": "docker compose -f infra/postgres.compose.yaml logs -f postgres",
    "docker:build": "docker build -f infra/Dockerfile -t advanced-javascript-org .",
    "docker:run": "docker run --rm --env-file apps/api/.env -e PORT=3000 -e API_PORT=8080 -e LOCAL_API_URL=http://127.0.0.1:8080 -e DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/app?schema=public -e WEB_ORIGIN=http://localhost:3000 -p 3000:3000 advanced-javascript-org",
    "docker:build-api": "docker build -f infra/api.Dockerfile -t advanced-javascript-org-api .",
    "docker:run-api": "docker run --rm --env-file apps/api/.env -p 8080:8080 advanced-javascript-org-api",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "db:migrate:dev": "pnpm --filter api prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter api prisma:migrate:deploy",
    "dev": "turbo run dev",
    "seed": "pnpm --filter api seed",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
