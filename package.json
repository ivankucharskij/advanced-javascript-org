{
  "name": "fullstack-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "db:up": "docker compose -f packages/database/compose.yaml up -d",
    "dev": "turbo run dev",
    "seed": "pnpm --filter api seed",
    "lint": "turbo run lint",
    "generate:api-client": "pnpm --filter @repo/api-client generate"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
